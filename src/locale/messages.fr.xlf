      <trans-unit id="account.security.heading" datatype="html"><source>Security</source><target>Sécurité</target></trans-unit>
      <trans-unit id="account.security.subtitle" datatype="html"><source> Change your password. You will be signed out on every device and must sign in again. </source><target>Modifiez votre mot de passe. Vous serez déconnecté sur tous vos appareils et devrez vous reconnecter.</target></trans-unit>
      <trans-unit id="account.security.currentPassword" datatype="html"><source>Current password</source><target>Mot de passe actuel</target></trans-unit>
